# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6334

# PostgreSQL Configuration
POSTGRES_DSN=postgres://user:password@localhost:5432/kindlast?sslmode=disable

# Redis Configuration (Single Instance)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Configuration (Cluster Mode)
# REDIS_CLUSTER_ADDRS=redis-node1:6379,redis-node2:6379,redis-node3:6379

# Cache Configuration
CACHE_TTL=24h

# Search Configuration
DEFAULT_TOP_K=10
DEFAULT_RERANK_K=20
MAX_EXCERPT_LENGTH=500

# Collection Names
GDPR_COLLECTION=gdpr_chunks
AI_ACT_COLLECTION=ai_act_chunks
