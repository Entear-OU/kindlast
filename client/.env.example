# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PREMIUM=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gateway API
# URL of the backend gateway service
NEXT_PUBLIC_API_URL=http://localhost:8080
# Request timeout in milliseconds (default: 30000)
NEXT_PUBLIC_API_TIMEOUT=30000
# Token refresh buffer in milliseconds - refresh tokens this much before expiry (default: 60000)
NEXT_PUBLIC_TOKEN_EXPIRY_BUFFER=60000

# Gateway auth cookie names (server-side only, not exposed to browser)
# Cookie name for storing gateway access token
GATEWAY_ACCESS_TOKEN_COOKIE=gateway_access_token
# Cookie name for storing gateway refresh token
GATEWAY_REFRESH_TOKEN_COOKIE=gateway_refresh_token
