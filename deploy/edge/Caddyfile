# The edge of the stack (core-api-surface §0). It owns the front door, a
# health endpoint, and from step 1 the route to core-api. Zitadel stays on its
# own published port for now because it validates the Host header against its
# external domain, and proxying it through here would couple the two configs
# for no step-0 benefit.
:80 {
	handle /healthz {
		respond "ok" 200
	}

	# core-api's Connect surface (ENT-197). The paths are fully qualified
	# proto names, so they namespace themselves and need no prefix stripping.
	#
	# This is the only way in. core-api publishes no ports, deliberately, so
	# reaching it means coming through here: a caller on the host and a
	# caller in another container use the same door, and there is no
	# development-only shortcut that stops existing in production.
	handle /kindlast.core.v1.* {
		reverse_proxy core-api:8080
	}

	# The platform surface (ENT-203). Routed, and the reasoning is worth stating
	# because "internal" invites the opposite conclusion.
	#
	# core-api publishes no ports, so a route it does not have here is a route
	# that exists nowhere: not for Temporal at build-order step 8, not for an
	# operator triggering a sweep, not for the Postman collection. Leaving it
	# out would be security by topology, and it breaks the first time anything
	# legitimately needs it.
	#
	# What actually gates it is the `internal:*` scope set, which is issued to
	# service clients through client credentials and never to the browser
	# client. Measured: a token without it is refused with permission_denied
	# before any handler runs.
	#
	# A production edge may still choose to restrict this block by source, and
	# that is a deployment decision rather than something to bake in here.
	handle /kindlast.platform.v1.* {
		reverse_proxy core-api:8080
	}

	# The payment provider's webhook (ENT-210).
	#
	# Routed because it is the one endpoint on core-api that a third party on
	# the internet has to reach. Everything else here is called by `web` or by a
	# service client, both of which talk to core-api directly on the compose
	# network; a provider cannot.
	#
	# ONE PATH, NOT THE WHOLE REST SURFACE
	#
	# core-api carries `google.api.http` annotations on every RPC, so
	# `/api/v1/me`, `/api/v1/records/...` and the rest all exist as handlers
	# already. They are deliberately NOT routed here. Opening the REST surface
	# is ENT-193's decision, with a gateway, CORS policy and per-key rate
	# limiting attached to it, and a wildcard added in passing for one webhook
	# would make that decision by accident.
	#
	# What protects the endpoint is the signature over the body, checked before
	# the body is parsed, plus a 64KB cap and idempotency on the provider's
	# event id. Being routed is not what makes it safe, and hiding it would not
	# have made it safe either.
	handle /api/v1/billing/webhook {
		reverse_proxy core-api:8080
	}

	# Everything else is the console and the marketing site (ENT-241).
	#
	# This block used to answer 404 with "web and core-api arrive at
	# build-order step 1". That was an honest description of a stack that
	# brought up every dependency and none of the product, and the note is
	# rewritten rather than deleted because the decision it deferred is the
	# one being made here: this is that step, and web is now a container in
	# this compose project like everything else.
	#
	# A CATCH-ALL RATHER THAN A LIST OF PATHS
	#
	# The opposite of the two blocks above, and deliberately so. core-api is
	# routed by explicit prefix because its REST surface is not open yet and a
	# wildcard would open it by accident. web is a website: its paths are
	# every marketing page, every console route under /o/{slug}/, the auth
	# redirect endpoints, the invitation and unsubscribe links in sent mail,
	# and the Next.js asset paths under /_next. Enumerating those would be a
	# list that goes stale the first time somebody adds a page, and the
	# failure would be a 404 on a real route rather than anything safe.
	#
	# Ordering is what keeps this honest: Caddy matches `handle` blocks most
	# specific first, so the routes above win and this one takes the rest.
	#
	# Note that /healthz above is the STACK's health, answered by Caddy
	# itself, so it never reaches web. web has its own /healthz, which is what
	# its container healthcheck probes on the compose network. Two questions,
	# two answers, and the one an operator watches from outside is this one.
	handle {
		reverse_proxy web:3000
	}
}
