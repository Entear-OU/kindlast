# Kindlast Local Development Environment Variables
# Copy to .env.local and fill in values

# ===========================================
# AI Provider API Keys
# ===========================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ===========================================
# Database Configuration (Docker Compose)
# ===========================================
POSTGRES_DSN=postgres://kindlast:localdev@postgres:5432/kindlast?sslmode=disable

# ===========================================
# Qdrant Configuration
# ===========================================
QDRANT_HOST=qdrant:6333

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Gateway Configuration
# ===========================================
PORT=8080
ENVIRONMENT=development
JWT_SECRET=local-dev-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
RAG_SERVICE_URL=http://rag:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60

# ===========================================
# RAG Service Configuration
# ===========================================
CACHE_TTL=24h
DEFAULT_TOP_K=10
DEFAULT_RERANK_K=20
MAX_EXCERPT_LENGTH=500
GDPR_COLLECTION=gdpr_chunks
AI_ACT_COLLECTION=ai_act_chunks

# ===========================================
# Ingestion Configuration
# ===========================================
MODE=regulatory

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_TOKEN_EXPIRY_BUFFER=60000

# ===========================================
# Supabase (optional for local dev)
# ===========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Stripe (optional for local dev)
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PREMIUM=
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production
