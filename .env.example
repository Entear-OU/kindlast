# ─── The web app against the self-managed stack ────────────────────────────
# Do not fill these in by hand. `./scripts/web-env.sh` writes apps/web/.env.local
# from the running compose stack, because the OAuth client is generated per
# environment into a docker volume and has no host-side path.
#
#   docker compose -f deploy/compose.yaml up -d
#   ./scripts/web-env.sh
#
# That is for a DEVELOPMENT SERVER on the host. The stack also serves the
# console itself now, in a container behind the edge (ENT-241), and that one
# needs none of this: compose points it at the same volume through
# KINDLAST_OIDC_CLIENT_FILE, so there is no step between `up -d` and a working
# sign-in. Both consoles can run at once, on 8000 and on 3000.

# ─── The model (ENT-235) ───────────────────────────────────────────────────
# NOTHING HERE IS REQUIRED. The compose stack runs its own model, so a
# deployment holding a compliance record needs no API key and no outbound
# internet. `model-init` fetches the weights once against a pinned SHA256 and
# `model` serves them, OpenAI-compatible, on :8081.
#
# Tier picks filename, URL and digest together. It is one variable rather than
# three because those three are a matched set: a filename from one model and a
# digest from another makes the init job delete a good file and fetch the
# wrong one.
#
#   2b  1.2 GB download, ~3.5 GB RAM
#   4b  2.7 GB download, ~5.5 GB RAM   (default)
#   9b  5.7 GB download, ~6.5 GB RAM
# KINDLAST_MODEL_TIER=4b
#
# Context size is a MEMORY decision, not a capability one. Qwen3.5 supports
# 262144 tokens natively and allocating that would want far more RAM than the
# weights themselves.
# KINDLAST_MODEL_CTX=16384
# KINDLAST_MODEL_PARALLEL=2
# KINDLAST_MODEL_PORT=8081
#
# A model outside the three tiers needs all three of these together. Setting
# only some is refused rather than merged with the tier's values.
# KINDLAST_MODEL_FILE=
# KINDLAST_MODEL_URL=
# KINDLAST_MODEL_SHA256=

# ─── Websearch / runtime corpus fetch (ENT-98, ENT-240) ────────────────────
# CURRENTLY UNUSED, AND NOTHING HERE IS REQUIRED. Nothing calls lib/websearch:
# the Analyst that fetched verbatim regulatory text at citation time went with
# the console, and the corpus landing in Postgres (ENT-207) removed the reason
# to fetch at all, since the obligation page links to EUR-Lex rather than
# pulling from it. Leave all four of these unset. Nothing degrades.
#
# The seam is kept rather than deleted because ENT-240 intends it for the one
# outbound fetch an air-gapped deployment permits: keeping the corpus current.
# Only one of the two providers can run inside such a deployment, which is why
# Firecrawl is the default: it self-hosts under AGPL-3.0, and Tavily has no
# self-hosting path at all.
#
# Firecrawl takes either the URL of your own instance or a key for the hosted
# API. Its self-hosted image runs with authentication off, so the URL alone is
# usually enough. With neither set, the provider refuses rather than reaching
# for the hosted API, which is the point: a source you named, or nothing.
# WEBSEARCH_PROVIDER=firecrawl
# FIRECRAWL_API_URL=http://firecrawl:3002
# FIRECRAWL_API_KEY=fc-...
# TAVILY_API_KEY=tvly-...

# ─── Billing (ENT-85 / ENT-86) ──────────────────────────────────────────────
# Subscriptions go through a swappable provider seam (lib/billing).
# BILLING_PROVIDER selects the implementation; `stripe` is the only one today.
BILLING_PROVIDER=stripe
# Stripe secret key and the €49/mo recurring price id for the Pro plan.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
# Webhook signing secret (ENT-86) — verifies the /api/webhooks/billing payload.
STRIPE_WEBHOOK_SECRET=whsec_...
# Absolute app origin for checkout return URLs. Optional: falls back to the
# request's forwarded host when unset. Also used for the one-tap links in
# finding emails (ENT-73).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Comms / email (ENT-73) ─────────────────────────────────────────────────
# The Comms agent emails founders when the Analyst creates a finding. Sends go
# through a swappable provider seam (lib/email). EMAIL_PROVIDER selects the
# implementation; `console` (the default) just logs, so local dev / CI need no
# key. Set `resend` + a key in production.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_...
# Verified sender for transactional mail.
# EMAIL_FROM=Kindlast <noreply@kindlast.com>
# Signs the one-tap Approve / Reject / Remind-me-later links in finding emails.
# Must be a long random secret; rotating it invalidates outstanding links.
NOTIFICATION_TOKEN_SECRET=change-me-to-a-long-random-secret
# Shared secret the notification crons present (Vercel Cron sends it as
# `Authorization: Bearer ${CRON_SECRET}`) to /api/notifications/dispatch
# (finding emails, every 5 min) and /api/notifications/briefing (the weekly
# Monday briefing, hourly tick that fires per-user at local Monday 09:00, ENT-74).
CRON_SECRET=change-me-to-a-long-random-secret
