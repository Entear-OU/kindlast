# Kindlast Local Development Environment Variables
# Copy to .env.local and fill in values

# ===========================================
# AI Provider API Keys
# ===========================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# ===========================================
# Database Configuration (Docker Compose)
# ===========================================
POSTGRES_DSN=postgres://kindlast:localdev@postgres:5432/kindlast?sslmode=disable

# ===========================================
# Qdrant Configuration
# ===========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Gateway Configuration
# ===========================================
PORT=8080
ENVIRONMENT=development
JWT_SECRET=local-dev-secret-change-in-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
RAG_SERVICE_URL=http://rag:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60

# ===========================================
# RAG Service Configuration
# ===========================================
# Provider: anthropic | openai | local
RAG_PROVIDER=openai
RAG_MODEL=
RAG_FALLBACK=

# LMstudio Configuration (when RAG_PROVIDER=local)
# LMstudio runs OpenAI-compatible API at localhost:1234
# Use host.docker.internal for Docker containers to reach host machine
OPENAI_API_BASE_URL=http://host.docker.internal:1234/v1

# Server timeouts (increase for local models which are slower)
SERVER_READ_TIMEOUT=120s
SERVER_WRITE_TIMEOUT=120s
RAG_TIMEOUT=120s

# Reranking
RERANK_ENABLED=true
RERANK_PROVIDER=cohere

CACHE_TTL=24h
DEFAULT_TOP_K=10
DEFAULT_RERANK_K=20
MAX_EXCERPT_LENGTH=500
GDPR_COLLECTION=kindlast_openai_prod
AI_ACT_COLLECTION=kindlast_openai_prod

# ===========================================
# Ingestion Configuration
# ===========================================
# Valid modes: incremental, full, single, processors
MODE=incremental

# Scraper Provider: firecrawl | tavily
SCRAPER_PROVIDER=firecrawl
TAVILY_DELAY_MS=500
TAVILY_EXTRACT_DEPTH=basic

# Embedding Provider: openai | cohere | local
EMBEDDING_PROVIDER=openai

# Local embedding settings (when EMBEDDING_PROVIDER=local)
# These take precedence over OPENAI_* equivalents
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BASE_URL=

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_TOKEN_EXPIRY_BUFFER=60000

# ===========================================
# Supabase (optional for local dev)
# ===========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# Stripe (optional for local dev)
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PREMIUM=
