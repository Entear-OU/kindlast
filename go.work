// A Go module per service, joined here for local development
// (core-api-surface §21.4). One module would mean one dependency set, so an
// upgrade for core-api would silently upgrade workers, and nothing would stop
// a careless import from crossing a service boundary.
//
// apps/workers and apps/intelligence join when they exist.
go 1.25.0

use (
	./apps/core-api
	./gen/go
	./libs/chassis
)
