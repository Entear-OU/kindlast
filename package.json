{
  "name": "kindlast",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "apps/web",
    "db/tests"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck",
    "test": "bun run --cwd apps/web test",
    "test:unit": "bun run --cwd apps/web test:unit",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:db": "bun run --cwd db/tests test",
    "test:watch": "bun run --cwd apps/web test:watch",
    "test:coverage": "bun run --cwd apps/web test:coverage"
  }
}
